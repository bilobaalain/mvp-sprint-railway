# Variables à saisir dans Railway (service backend > Variables). Ne jamais committer le vrai .env.
MONGO_URL=mongodb://...            # Railway : ${{MongoDB.MONGO_URL}}
DB_NAME=rade_brest
JWT_SECRET=chaine_aleatoire_longue  # ex. : python -c "import secrets; print(secrets.token_hex(32))"
CORS_ORIGINS=https://ton-frontend.up.railway.app
RESEND_API_KEY=                     # optionnel : sans clé, l'e-mail est seulement journalisé
SENDER_EMAIL=onboarding@resend.dev
FRONTEND_URL=https://ton-frontend.up.railway.app   # liens dans les e-mails
# Envoi des e-mails : Brevo (prioritaire, expéditeur vérifié suffit) ou Resend (domaine vérifié requis)
BREVO_API_KEY=
SENDER_NAME=Ensemble pour sauver la rade
